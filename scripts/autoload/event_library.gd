extends Node
## The 155 scripted events from design section 17, loaded from data/events/events.json
## (generated by tools/build_events.py), plus the playable scenes built so far in data/scenes/.

const EVENTS_PATH := "res://data/events/events.json"
const SCENES_DIR := "res://data/scenes/"

var categories := {}
var events := {}
var order: Array[String] = []
var scenes := {}


func _ready() -> void:
	load_all()


func load_all() -> void:
	events.clear()
	order.clear()
	scenes.clear()
	var doc: Variant = JSON.parse_string(FileAccess.get_file_as_string(EVENTS_PATH))
	assert(typeof(doc) == TYPE_DICTIONARY, "Could not parse %s" % EVENTS_PATH)
	categories = doc.categories
	for e in doc.events:
		events[e.id] = e
		order.append(e.id)
	var dir := DirAccess.open(SCENES_DIR)
	if dir == null:
		return
	for file in dir.get_files():
		if file.ends_with(".json"):
			var scene: Variant = JSON.parse_string(FileAccess.get_file_as_string(SCENES_DIR + file))
			assert(typeof(scene) == TYPE_DICTIONARY, "Could not parse scene %s" % file)
			scenes[scene.event] = scene


func get_event(event_id: String) -> Dictionary:
	return events.get(event_id, {})


func in_category(code: String) -> Array:
	return order.filter(func(id): return events[id].category == code)


## Events whose trigger names this flag.
func reading_flag(flag: String) -> Array:
	return order.filter(func(id): return flag in events[id].reads_flags)


## Events whose consequences set this flag.
func setting_flag(flag: String) -> Array:
	return order.filter(func(id): return flag in events[id].sets_flags)


func has_scene(event_id: String) -> bool:
	return scenes.has(event_id)


func scene_for(event_id: String) -> Dictionary:
	return scenes.get(event_id, {})


## Checks a scene graph: a start node, every link resolves, every node is reachable, every path ends.
## Returns a list of problems; empty means the scene is well formed.
func validate_scene(scene: Dictionary) -> Array[String]:
	var problems: Array[String] = []
	var nodes: Dictionary = scene.get("nodes", {})
	if not events.has(scene.get("event", "")):
		problems.append("scene names unknown event %s" % scene.get("event", ""))
	if not nodes.has(scene.get("start", "")):
		problems.append("missing start node")
		return problems
	var seen := {}
	var stack: Array = [scene.start]
	while not stack.is_empty():
		var id: String = stack.pop_back()
		if seen.has(id):
			continue
		seen[id] = true
		var node: Dictionary = nodes[id]
		var links: Array = []
		if node.has("next"):
			links.append(node.next)
		for choice in node.get("choices", []):
			if not choice.has("text"):
				problems.append("%s: choice without text" % id)
			for key in ["next", "on_success", "on_failure"]:
				if choice.has(key):
					links.append(choice[key])
			if choice.has("check") and not (choice.has("on_success") and choice.has("on_failure")):
				problems.append("%s: check without both outcomes" % id)
		if links.is_empty() and not node.get("end", false):
			problems.append("%s: dead end without end: true" % id)
		for link in links:
			if not nodes.has(link):
				problems.append("%s: links to missing node %s" % [id, link])
			else:
				stack.append(link)
	for id in nodes:
		if not seen.has(id):
			problems.append("%s: unreachable" % id)
	return problems
